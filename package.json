{
  "name": "flash-dev",
  "version": "3.1.0",
  "description": "Copilote intelligent pour votre terminal \u2014 Automatisez Git, s\u00e9curisez vos commits, analysez vos projets \u2014 100% Gratuit & Open-Source",
  "bin": {
    "flash-dev": "bin/index.js"
  },
  "scripts": {
    "lint": "node scripts/syntax-check.js",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dominiqsoro/flash-dev.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "ai",
    "analyze",
    "automation",
    "changelog",
    "cli",
    "conventional-commits",
    "copilot",
    "deps",
    "developer-tools",
    "diagnostics",
    "docker",
    "doctor",
    "gemini",
    "git",
    "hooks",
    "laravel",
    "licenses",
    "nextjs",
    "ports",
    "secrets",
    "security"
  ],
  "author": "dominiqsoro",
  "license": "GPL-3.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/dominiqsoro/flash-dev/issues"
  },
  "homepage": "https://github.com/dominiqsoro/flash-dev#readme",
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!src/__tests__/**"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/?(*.)+(test).js"
    ]
  }
}
